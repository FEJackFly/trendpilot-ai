# 复制为 .env 后按需修改：cp .env.example .env
# .env 已加入 .gitignore，绝不提交真实密钥。
NODE_ENV=development
PORT=3001
DATABASE_URL=./data/trendpilot.db
DATA_MODE=mock

# AI 提供商：mock | openai | anthropic | custom（默认 mock，无需密钥）
AI_PROVIDER=mock
# 真实 provider 必填：只放在服务端环境变量或凭据存储中，绝不写进前端代码
AI_API_KEY=
# OpenAI 兼容接口地址；openai 可缺省（默认 https://api.openai.com/v1）；
# anthropic/custom 必填（指向 OpenAI 兼容网关）
AI_BASE_URL=
# 模型名；缺省时按 provider 取默认值
AI_MODEL=

# X 官方 API（本阶段默认关闭，不发起任何外部调用）
X_API_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_API_ENABLED=true 时必填：X API v2 应用级 Bearer Token
X_BEARER_TOKEN=
